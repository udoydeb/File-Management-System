# ==========================================
# DIU SMART ARCHIVE - PRODUCTION ENVIRONMENT VARIABLES
# ==========================================

# 1. Supabase Configurations (Cloud Database Sync & Authentication)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 2. Application Endpoint Configurations
# URL of the hosted application (for relative link building and self-referential redirects)
NEXT_PUBLIC_APP_URL=
# Base URL targeting your running Express backend server (for static frontend hosts like Vercel calling Render backend)
VITE_API_URL=

# 3. Security Credentials & Secrets
# JSON Web Token password for signing offline registry session logs
JWT_SECRET=
# Google Gemini Large Language Model Key for Document AI analysis and Semantic Smart Searches
GEMINI_API_KEY=

# 4. Runtime Mode Node Identifier
NODE_ENV=production
